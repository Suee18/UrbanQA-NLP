# Copy this file to ".env" and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Qdrant Cloud ──────────────────────────────────────────────────────────
# From https://cloud.qdrant.io after creating a free cluster:
#   - QDRANT_URL  = your cluster endpoint (ends with :6333)
#   - QDRANT_API_KEY = the key you created under "API Keys"
# For a LOCAL Qdrant (docker run -p 6333:6333 qdrant/qdrant) use:
#   QDRANT_URL=http://localhost:6333  and leave QDRANT_API_KEY empty.
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Anthropic (only needed if generator.backend = "api" in config.yaml) ───
ANTHROPIC_API_KEY=your-anthropic-api-key
